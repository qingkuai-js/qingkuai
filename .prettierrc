{
  "printWidth": 100,
  "semi": true,
  "tabWidth": 4,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "overrides": [
    {
      "files": [".*rc", "*.json", "*.yml", "*.yaml"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["regular.ts", "src/types/qingkuai.d.ts"],
      "options": {
        "printWidth": 200
      }
    }
  ]
}
